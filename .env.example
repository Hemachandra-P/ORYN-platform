# ========================================================
# Vyna Environment Configuration Example
# ========================================================

# PROJECT
PROJECT_NAME="Vyna"
PROJECT_VERSION="1.0.0"

# SECURITY
SECRET_KEY="replace-with-a-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# DATABASE
# Local zero-configuration SQLite (default):
DATABASE_URL="sqlite:///./nestsync.db"
# Or PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nestsync"

# RAZORPAY PAYMENT GATEWAY (Test Mode Defaults)
RAZORPAY_KEY_ID="rzp_test_nestsync_mock_id"
RAZORPAY_KEY_SECRET="mock_razorpay_secret_key_12345"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_67890"

# AI PROVIDER
AI_PROVIDER="mock"  # "mock", "gemini", or "openai"
AI_API_KEY=""

# BOOTSTRAP SUPER ADMIN CREDENTIALS
FIRST_SUPERUSER_EMAIL="admin@nestsync.com"
FIRST_SUPERUSER_PASSWORD="Admin@NestSync2026!"
FIRST_SUPERUSER_NAME="Platform Super Admin"

# SUPABASE (Optional Storage & Auth)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# WEB FRONTEND
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
